# Server
PORT=9990
HOST=0.0.0.0
SERVER_URL=http://localhost:9990
SERVER_NAME=Fetcherr
SERVER_ID=fetcherr-001

# Database
DATABASE_PATH=/app/data/fetcherr.db

# Metadata APIs (required)
TMDB_API_KEY=
TVDB_API_KEY=

# Trakt (at least one list source required)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_USERNAME=
TRAKT_LISTS=
TRAKT_WATCHLIST_MOVIES=true
TRAKT_WATCHLIST_SHOWS=true
TRAKT_WATCH_HISTORY=false
TRAKT_COLLECTIONS=false
TRAKT_FOLDERS=false

# MDBList (optional, alternative/additional list source)
MDBLIST_API_KEY=
MDBLIST_LISTS=
MDBLIST_FOLDERS=false
MDBLIST_MAX_ITEMS=1000

# Library behaviour
SHOW_ADD_DEFAULT_MODE=all
MOVIE_RELEASE_MODE=digital

# Prowlarr (required — DrunkenSlug + NZBGeek indexers)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# NNTP provider (required — Newshosting)
NNTP_HOST=news.newshosting.com
NNTP_PORT=563
NNTP_USER=
NNTP_PASS=
NNTP_SSL=true
NNTP_CONNECTIONS=10
